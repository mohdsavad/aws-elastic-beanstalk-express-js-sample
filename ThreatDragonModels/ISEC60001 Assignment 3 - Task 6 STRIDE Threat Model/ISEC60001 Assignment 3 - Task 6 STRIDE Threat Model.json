  "summary": {
    "title": "ISEC60001 Assignment 3 - Task 6 STRIDE Threat Model",
    "owner": "Mohammed Savad",
    "description": "This threat model analyses a three-tier web application consisting of a User Interface (UI), a Web Application, and a Database. Users interact with the UI to submit requests and access information. The Web Application processes requests, performs authentication and authorisation, and communicates with the Database to store and retrieve information. The STRIDE methodology is used to identify security threats involving spoofing, tampering, repudiation, information disclosure, denial of service, and elevation of privilege.",
    "id": 0
  },
