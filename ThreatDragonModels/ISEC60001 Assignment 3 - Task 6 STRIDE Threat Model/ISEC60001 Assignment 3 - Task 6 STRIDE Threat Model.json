            "data": {
              "type": "tm.Process",
              "name": "Web App",
              "description": "",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "b30d3484-223d-4600-98fa-7ceed535af29",
                  "title": "Action Repudiation",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "A user may deny performing an action within the web application if sufficient audit logs and transaction records are not maintained, making it difficult to investigate unauthorised activities.",
                  "mitigation": "mplement secure audit logging, record user activities with timestamps and unique identifiers, protect logs against unauthorised modification, and regularly monitor audit records.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": "6"
                },
                {
                  "id": "fff81663-8cb3-4a6b-aeb2-4609943fec2c",
                  "title": "Web Application Denial of Service",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "An attacker may overwhelm the web application with excessive requests, exhausting server resources and making the application unavailable to legitimate users. This may result in service disruption, reduced performance, and loss of availability.",
                  "mitigation": "Implement rate limiting, web application firewall (WAF) protection, traffic monitoring, request throttling, resource limits, and automatic scaling to reduce the impact of denial-of-service attacks.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": "8"
                },
                {
                  "id": "f169400d-ab11-4740-a3e8-de1b7e3698ea",
                  "title": "Unauthorised Privilege Escalation",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Elevation of privilege",
                  "description": "An attacker may exploit weaknesses in authentication, authorisation, or access control mechanisms to gain higher-level privileges within the web application. This could allow unauthorised access to administrative functions, modification of sensitive information, or control over application resources.",
                  "mitigation": "Implement role-based access control (RBAC), enforce the principle of least privilege, validate permissions on the server side, use multi-factor authentication for privileged accounts, and regularly review user roles and access permissions.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": "9"
                }
              ],
              "threatFrequency": {
                "spoofing": 0,
                "tampering": 0,
                "repudiation": 1,
                "informationDisclosure": 0,
                "denialOfService": 1,
                "elevationOfPrivilege": 1
              }
            },
            "zIndex": 3
